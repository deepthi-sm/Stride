# Firebase web config for Google sign-in and Calendar.
# Copy to client/.env and fill in from the Firebase console. Never commit .env.
# Vite only exposes vars prefixed VITE_. Restart `npm run dev` after editing.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
